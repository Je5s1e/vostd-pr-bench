+    opens_invariants none
+    no_unwind
+;
+
+pub assume_specification[ Flags::is_execute ](flags: &Flags) -> bool
+    returns
+        flags.0 & 1 == 1,
+    opens_invariants none
+    no_unwind
+;
+
+pub assume_specification[ Flags::is_read ](flags: &Flags) -> bool
+    returns
+        flags.0 & 4 == 4,
+    opens_invariants none
+    no_unwind
+;
+
+pub assume_specification[ Flags::is_write ](flags: &Flags) -> bool
+    returns
+        flags.0 & 2 == 2,
+    opens_invariants none
+    no_unwind
+;
