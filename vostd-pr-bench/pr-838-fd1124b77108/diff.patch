 /// Returns an iterator over all CPUs.
+///
+/// # Verified Properties
+///
+/// ## Safety
+/// - CPU IDs are valid, relying on the trusted CPU count contract and bounds.
+///
+/// ## Functional Correctness
+/// - IDs form an ascending prefix of `0..num_cpus()`.
+///
+/// ## Preconditions
+/// - None.
+///
+/// ## Postconditions
+/// - Obeys iterator laws.
+/// - Has a decreasing measure.
+/// - Yields at most `num_cpus()` IDs.
+/// - Covers every CPU exactly once if iteration completes.
+#[verus_verify]
+#[verus_spec(ret =>
+    ensures
+        IteratorSpec::obeys_prophetic_iter_laws(&ret),
+        IteratorSpec::decrease(&ret) is Some,
+        IteratorSpec::remaining(&ret).len() <= cpu_count(),
+        forall|i: int| 0 <= i < IteratorSpec::remaining(&ret).len() ==>
+            #[trigger] IteratorSpec::remaining(&ret)[i]@ == i,
+        IteratorSpec::will_return_none(&ret) ==>
+            IteratorSpec::remaining(&ret).len() == cpu_count(),
+)]
 pub fn all_cpus() -> impl Iterator<Item = CpuId> {
-    (0..num_cpus()).map(|id| CpuId(id as u32))
+    proof! {
+        broadcast use { axiom_cpu_count_bounds, vstd::std_specs::iter::group_iter_axioms };
+    }
+    (0..num_cpus()).map(
+        #[verus_spec(ret: CpuId =>
+            requires
+                id < cpu_count(),
+            ensures
+                ret@ == id,
+        )]
+        |id| CpuId(id as u32),
+    )
 }
 
