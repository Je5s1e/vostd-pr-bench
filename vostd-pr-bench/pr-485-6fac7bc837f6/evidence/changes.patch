+{
+    let bytes = pod_bytes::<T>(v);
+    let chosen: T = choose|w: T| pod_bytes::<T>(w) == bytes;
+    assert(pod_bytes::<T>(chosen) == bytes);
+    broadcast use axiom_pod_bytes_injective;
+}
