+            assert(self.view_rec(path).contains(expected));
+            assert(ambient.contains(expected));
+            assert(vaddr_of::<C>(path) as int != vaddr_of::<C>(removed_path) as int);
+            assert(self.0.value.path != removed_path);
+        }
+        assert(g(self.0.value, path));
