+                    start: vaddr_of::<C>(path) as int,
+                    end: vaddr_of::<C>(path) as int + page_size(pt_level) as int,
+                },
+                pa_range: Range {
+                    start: frame.mapped_pa,
+                    end: (frame.mapped_pa + page_size(pt_level)) as Paddr,
+                },
+                page_size: page_size(pt_level),
+                property: frame.prop,
+            };
