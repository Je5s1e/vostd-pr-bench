+    pub open spec fn root(&self) -> NodeId
+        recommends
+            *self !is Void,
+    {
+        match *self {
+            Self::Void => arbitrary(),
+            Self::Locking(rt, _) => rt,
+            Self::Locked(rt) => rt,
+        }
+    }
 }
 
