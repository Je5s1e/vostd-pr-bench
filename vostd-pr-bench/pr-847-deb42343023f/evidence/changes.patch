index b3ddd0a72..2821fa0f0 100644
--- a/ostd/specs/arch/mod.rs
+++ b/ostd/specs/arch/mod.rs
@@ -12,7 +12,10 @@
 //! trust the current layout; that restriction is not enforced for other configurations.
 use vstd::prelude::*;
 
-use crate::mm::Paddr;
