 // SPDX-License-Identifier: MPL-2.0
+use vstd::{arithmetic::power2::*, prelude::*};
+use vstd_extra::{external::ilog2::*, ownership::Inv};
+
+use crate::specs::arch::valid_frame_paddr;
+
 use alloc::fmt;
