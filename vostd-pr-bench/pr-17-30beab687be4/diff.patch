+        &&& forall|i: int| #![auto] 0 <= i < MAX_NR_PAGES() <==> self.pages.dom().contains(i)
+        &&& forall|i: int|
+            {
+                0 <= i < MAX_NR_PAGES() ==> {
+                    #[trigger] self.pages.dom().contains(i) && self.pages[i].index == i
