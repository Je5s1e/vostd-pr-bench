+    pub open spec fn invariants(&self) -> bool {
+        &&& self.inv_tlb()
+        &&& self.inv_page()
+        &&& forall|i: int|
+            #![auto]
+            0 <= i < self.tlb_queues.len() ==> {
+                &&& self.tlb_queues[i].invariants()
+                &&& self.tlb_queues[i].page_keeper.cpu_is_owner(i)
