+/// Root-owned physical resources and authoritative live-lease accounting.
+#[verifier::reject_recursive_types(T)]
+pub tracked struct RcuRootPermissionState<T, O> {
+    pools: RcuReadLeaseRegistry<nat, O, CpuRcuLeaseWitness>,
+    active: GhostMapAuth<nat, RcuActiveReadLeaseRecord<nat, CpuRcuLeaseWitness>>,
+    reclaimed: Map<nat, RcuReclaimPermit>,
+    claims: GhostMapAuth<nat, Option<*mut T>>,
+    unretired: Map<nat, RcuReclaimClaim<T>>,
+    ghost allocated: Set<nat>,
+    ghost scheduler: Loc,
+    ghost domain: Loc,
+    ghost observations: Loc,
+    ghost online: Set<CpuId>,
+}
+
+impl<T, O> Inv for RcuRootPermissionState<T, O> {
+    closed spec fn inv(self) -> bool {
+        &&& self.pools.wf()
+        &&& self.pools.keys().union(self.reclaimed.dom()) == self.allocated
+        &&& self.pools.keys().disjoint(self.reclaimed.dom())
+        &&& self.claims@.dom() == self.allocated
+        &&& forall|obj: nat| #[trigger]
+            self.claims@.contains_key(obj) ==> {
+                (self.claims@[obj] is Some) == self.pools.keys().contains(obj)
+            }
+        &&& self.unretired.dom().subset_of(self.pools.keys())
+        &&& forall|obj: nat| #[trigger]
+            self.unretired.contains_key(obj) ==> {
+                let claim = self.unretired[obj];
+                &&& claim.inv()
+                &&& claim.obj() == obj
+                &&& claim.registry() == self.claims.id()
+                &&& self.claims@[obj] == Some(claim.ptr())
+            }
+        &&& forall|obj: nat| #[trigger]
+            self.reclaimed.contains_key(obj) ==> {
+                let permit = self.reclaimed[obj];
+                &&& permit.inv()
+                &&& permit.summary().retired.obj == obj
+                &&& permit.summary().retired.domain == self.domain
+                &&& permit.summary().retired.retire_observation_registry == self.observations
+                &&& permit.summary().scheduler == self.scheduler
+                &&& permit.online() == self.online
+            }
+        &&& self.active@.dom() == self.pools.active_ids()
+        &&& forall|id: nat| #[trigger]
+            self.pools.active_ids().contains(id) ==> {
+                let record = self.pools.active_record(id);
+                let witness = record.witness();
+                &&& witness.inv()
+                &&& witness.scheduler() == self.scheduler
+                &&& witness.domain() == self.domain
+                &&& witness.observations() == self.observations
+                &&& witness.obj() == record.key()
+                &&& self.online.contains(witness.reader().cpu())
+                &&& self.active@[id] == record
+            }
+    }
+}
+
+impl<T, O> RcuRootPermissionState<T, O> {
+    /// Creates an empty registry for a fixed scheduler, root, and online CPU set.
+    pub proof fn tracked_empty(
+        scheduler: Loc,
+        domain: Loc,
+        observations: Loc,
+        online: Set<CpuId>,
+    ) -> (tracked res: Self)
+        ensures
+            res.inv(),
+            res.keys() == Set::<nat>::empty(),
+            res.allocations() == Set::<nat>::empty(),
+            res.unretired() == Set::<nat>::empty(),
+            res.scheduler() == scheduler,
+            res.domain() == domain,
+            res.observations() == observations,
+            res.online() == online,
+    {
+        let tracked pools = RcuReadLeaseRegistry::empty();
+        let tracked (active, _) = GhostMapAuth::new(Map::empty());
+        let tracked (claims, _) = GhostMapAuth::new(Map::empty());
+        let tracked res = Self {
+            pools,
+            active,
+            reclaimed: Map::tracked_empty(),
+            allocated: Set::empty(),
+            claims,
+            unretired: Map::tracked_empty(),
+            scheduler,
+            domain,
+            observations,
+            online,
+        };
+        assert(res.pools.keys().union(res.reclaimed.dom()) =~= res.allocated);
+        res
+    }
+
+    /// Allocations whose physical permission has not yet been recovered.
+    pub closed spec fn keys(self) -> Set<nat> {
+        self.pools.keys()
+    }
+
+    /// All allocation IDs ever inserted, including reclaimed allocations.
+    pub closed spec fn allocations(self) -> Set<nat> {
+        self.allocated
+    }
+
+    /// Identity of the active-record registry.
+    pub closed spec fn registry(self) -> Loc {
+        self.active.id()
+    }
+
+    /// Unique-claim registry, retained across allocation and reclamation.
+    pub closed spec fn reclaim_registry(self) -> Loc {
+        self.claims.id()
+    }
+
+    /// Exact pointer associated with an unreclaimed allocation.
+    pub closed spec fn ptr(self, obj: nat) -> *mut T {
+        self.claims@[obj]->Some_0
+    }
+
+    /// Allocations whose unique reclaim claim is still retained by the root.
+    pub closed spec fn unretired(self) -> Set<nat> {
+        self.unretired.dom()
+    }
+
+    /// Canonical CPU scheduler identity.
+    pub closed spec fn scheduler(self) -> Loc {
+        self.scheduler
+    }
+
+    /// Root allocation domain.
+    pub closed spec fn domain(self) -> Loc {
+        self.domain
+    }
+
+    /// Retirement certificate authority.
+    pub closed spec fn observations(self) -> Loc {
+        self.observations
+    }
+
+    /// Stable CPU set containing every reader allowed to acquire a lease.
+    pub closed spec fn online(self) -> Set<CpuId> {
+        self.online
+    }
+
+    /// Full permission stored under a live allocation ID.
+    pub closed spec fn ownership(self, obj: nat) -> O {
+        self.pools.accumulator(obj).resource()
+    }
+
+    /// Whether an allocation still has an outstanding physical lease.
+    pub closed spec fn has_active(self, obj: nat) -> bool {
+        self.pools.has_active(obj)
+    }
+
+    /// A claim still retained by the root names an unreclaimed physical pool.
+    pub proof fn lemma_unretired_live(self, obj: nat)
+        requires
+            self.inv(),
+            self.unretired().contains(obj),
+        ensures
+            self.keys().contains(obj),
+    {
+    }
+
+    /// Inserts a fresh allocation; reclaiming an ID never makes it reusable.
+    pub proof fn tracked_insert(tracked &mut self, obj: nat, ptr: *mut T, tracked ownership: O)
+        requires
+            old(self).inv(),
+            !old(self).allocations().contains(obj),
+        ensures
+            final(self).inv(),
+            final(self).keys() == old(self).keys().insert(obj),
+            final(self).allocations() == old(self).allocations().insert(obj),
+            final(self).ownership(obj) == ownership,
+            final(self).ptr(obj) == ptr,
+            final(self).unretired() == old(self).unretired().insert(obj),
+            final(self).reclaim_registry() == old(self).reclaim_registry(),
+            final(self).registry() == old(self).registry(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).domain() == old(self).domain(),
+            final(self).observations() == old(self).observations(),
+            final(self).online() == old(self).online(),
+            forall|other: nat| #[trigger]
+                old(self).keys().contains(other) ==> final(self).ownership(other) == old(
+                    self,
+                ).ownership(other),
+            forall|other: nat| #[trigger]
+                old(self).keys().contains(other) ==> equal(
+                    final(self).ptr(other),
+                    old(self).ptr(other),
+                ),
+    {
+        self.pools.lemma_all_contains_iff_keys();
+        self.pools.insert(obj, ownership);
+        let tracked entry = self.claims.insert(obj, Some(ptr));
+        self.unretired.tracked_insert(obj, RcuReclaimClaim { entry });
+        self.allocated = self.allocated.insert(obj);
+        assert(self.pools.keys().union(self.reclaimed.dom()) =~= self.allocated);
+        assert(self.pools.keys().disjoint(self.reclaimed.dom()));
+    }
+
+    /// Issues a lease only with a non-expired, canonical CPU witness.
+    pub proof fn tracked_lease(
+        tracked &mut self,
+        tracked witness: CpuRcuLeaseWitness,
+    ) -> (tracked res: RcuRootReadLease<O>)
+        requires
+            old(self).inv(),
+            old(self).keys().contains(witness.obj()),
+            witness.inv(),
+            witness.scheduler() == old(self).scheduler(),
+            witness.domain() == old(self).domain(),
+            witness.observations() == old(self).observations(),
+            old(self).online().contains(witness.reader().cpu()),
+        ensures
+            final(self).inv(),
+            final(self).keys() == old(self).keys(),
+            final(self).allocations() == old(self).allocations(),
+            final(self).registry() == old(self).registry(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).domain() == old(self).domain(),
+            final(self).observations() == old(self).observations(),
+            final(self).online() == old(self).online(),
+            forall|obj: nat| #[trigger]
+                old(self).keys().contains(obj) ==> final(self).ownership(obj) == old(
+                    self,
+                ).ownership(obj),
+            res.inv(),
+            res.registry() == old(self).registry(),
+            res.obj() == witness.obj(),
+            res.witness() == witness,
+            res.resource() == old(self).ownership(witness.obj()),
+            final(self).unretired() == old(self).unretired(),
+            final(self).reclaim_registry() == old(self).reclaim_registry(),
+            forall|obj: nat| #[trigger]
+                old(self).keys().contains(obj) ==> equal(final(self).ptr(obj), old(self).ptr(obj)),
+    {
+        self.pools.lemma_all_contains_iff_keys();
+        let tracked lease = self.pools.split_lease(witness.obj(), witness);
+        let ghost id = lease.lease_id();
+        let ghost binding = self.pools.active_record(id);
+        let tracked active = self.active.insert(id, binding);
+        assert forall|other: nat| #[trigger] self.pools.active_ids().contains(other) implies {
+            let record = self.pools.active_record(other);
+            let w = record.witness();
+            &&& w.inv()
+            &&& w.scheduler() == self.scheduler
+            &&& w.domain() == self.domain
+            &&& w.observations() == self.observations
+            &&& w.obj() == record.key()
+            &&& self.online.contains(w.reader().cpu())
+            &&& self.active@[other] == record
+        } by {
+            if other != id {
+                assert(old(self).pools.active_ids().contains(other));
+            }
+        };
+        RcuRootReadLease { lease, active }
+    }
+
+    /// Returns the exact active lease and restores its CPU resource to the caller.
+    pub proof fn tracked_return(
+        tracked &mut self,
+        tracked lease: RcuRootReadLease<O>,
+    ) -> (tracked witness: CpuRcuLeaseWitness)
+        requires
+            old(self).inv(),
+            lease.inv(),
+            lease.registry() == old(self).registry(),
+        ensures
+            final(self).inv(),
+            witness.inv(),
+            final(self).keys() == old(self).keys(),
+            final(self).allocations() == old(self).allocations(),
+            final(self).registry() == old(self).registry(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).domain() == old(self).domain(),
+            final(self).observations() == old(self).observations(),
+            final(self).online() == old(self).online(),
+            forall|obj: nat| #[trigger]
+                old(self).keys().contains(obj) ==> final(self).ownership(obj) == old(
+                    self,
+                ).ownership(obj),
+            final(self).unretired() == old(self).unretired(),
+            final(self).reclaim_registry() == old(self).reclaim_registry(),
+            forall|obj: nat| #[trigger]
+                old(self).keys().contains(obj) ==> equal(final(self).ptr(obj), old(self).ptr(obj)),
+        returns
+            lease.witness(),
+    {
+        self.pools.lemma_all_contains_iff_keys();
+        lease.active.agree(&self.active);
+        let tracked witness = self.pools.return_lease(lease.lease);
+        self.active.delete_points_to(lease.active);
+        witness
+    }
+
+    /// Transfers the root's unique claim to the pending reclamation callback.
+    pub proof fn tracked_take_claim(tracked &mut self, obj: nat) -> (tracked res: RcuReclaimClaim<
+        T,
+    >)
+        requires
+            old(self).inv(),
+            old(self).unretired().contains(obj),
+        ensures
+            final(self).inv(),
+            final(self).unretired() == old(self).unretired().remove(obj),
+            final(self).keys() == old(self).keys(),
+            final(self).allocations() == old(self).allocations(),
+            final(self).registry() == old(self).registry(),
+            final(self).reclaim_registry() == old(self).reclaim_registry(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).domain() == old(self).domain(),
+            final(self).observations() == old(self).observations(),
+            final(self).online() == old(self).online(),
+            forall|key: nat| #[trigger]
+                old(self).keys().contains(key) ==> {
+                    &&& final(self).ownership(key) == old(self).ownership(key)
+                    &&& equal(final(self).ptr(key), old(self).ptr(key))
+                },
+            res.inv(),
+            res.obj() == obj,
+            res.registry() == old(self).reclaim_registry(),
+            equal(res.ptr(), old(self).ptr(obj)),
+    {
+        self.unretired.tracked_remove(obj)
+    }
+
+    /// Checks a callback's exact pointer against the root's authoritative claim map.
+    pub proof fn lemma_claim_agrees(tracked &self, tracked claim: &RcuReclaimClaim<T>)
+        requires
+            self.inv(),
+            claim.inv(),
+            claim.registry() == self.reclaim_registry(),
+        ensures
+            self.keys().contains(claim.obj()),
+            equal(self.ptr(claim.obj()), claim.ptr()),
+    {
+        claim.entry.agree(&self.claims);
+    }
+
+    /// Rules out a stale history message for an already reclaimed allocation.
+    ///
+    /// Retained completion evidence handles arbitrarily late weak loads; the
+    /// allocation ID is never forgotten when its physical pool is removed.
+    pub proof fn lemma_live_allocation(tracked &self, tracked witness: &mut CpuRcuLeaseWitness)
+        requires
+            self.inv(),
+            old(witness).inv(),
+            self.allocations().contains(old(witness).obj()),
+            old(witness).scheduler() == self.scheduler(),
+            old(witness).domain() == self.domain(),
+            old(witness).observations() == self.observations(),
+            self.online().contains(old(witness).reader().cpu()),
+        ensures
+            *final(witness) == *old(witness),
+            self.keys().contains(final(witness).obj()),
+    {
+        if !self.keys().contains(witness.obj()) {
+            let tracked permit = self.reclaimed.tracked_borrow(witness.obj());
+            witness.lemma_excluded(permit);
+        }
+    }
+
+    /// Derives absence of live leases from grace-period reports, not an assumption.
+    pub proof fn lemma_no_active(tracked &mut self, tracked permit: &RcuReclaimPermit)
+        requires
+            old(self).inv(),
+            permit.inv(),
+            permit.summary().scheduler == old(self).scheduler(),
+            permit.summary().retired.domain == old(self).domain(),
+            permit.summary().retired.retire_observation_registry == old(self).observations(),
+            permit.online() == old(self).online(),
+        ensures
+            *final(self) == *old(self),
+            !final(self).has_active(permit.summary().retired.obj),
+    {
+        let ghost obj = permit.summary().retired.obj;
+        if self.pools.has_active(obj) {
+            let ghost id = choose|id: nat| #[trigger]
+                self.pools.active_ids().contains(id) && self.pools.active_record(id).key() == obj;
+            let tracked witness = self.pools.tracked_borrow_active_witness_mut(id);
+            witness.lemma_excluded(permit);
+        }
+    }
+
+    /// Consumes the retired registration and recovers its full physical permission once.
+    pub proof fn tracked_reclaim(
+        tracked &mut self,
+        tracked retired: RcuRetiredRegistration<T>,
+        tracked claim: RcuReclaimClaim<T>,
+        tracked permit: RcuReclaimPermit,
+    ) -> (tracked ownership: O)
+        requires
+            old(self).inv(),
+            permit.inv(),
+            retired.record() == permit.summary().retired,
+            permit.summary().scheduler == old(self).scheduler(),
+            permit.summary().retired.domain == old(self).domain(),
+            permit.summary().retired.retire_observation_registry == old(self).observations(),
+            permit.online() == old(self).online(),
+            old(self).keys().contains(retired.record().obj),
+            claim.inv(),
+            claim.registry() == old(self).reclaim_registry(),
+            claim.obj() == retired.record().obj,
+            claim.ptr() == retired.ptr(),
+        ensures
+            final(self).inv(),
+            final(self).keys() == old(self).keys().remove(retired.record().obj),
+            final(self).allocations() == old(self).allocations(),
+            final(self).registry() == old(self).registry(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).domain() == old(self).domain(),
+            final(self).observations() == old(self).observations(),
+            final(self).online() == old(self).online(),
+            final(self).reclaim_registry() == old(self).reclaim_registry(),
+            final(self).unretired() == old(self).unretired(),
+            forall|obj: nat| #[trigger]
+                final(self).keys().contains(obj) ==> final(self).ownership(obj) == old(
+                    self,
+                ).ownership(obj),
+            forall|obj: nat| #[trigger]
+                final(self).keys().contains(obj) ==> equal(
+                    final(self).ptr(obj),
+                    old(self).ptr(obj),
+                ),
+        returns
+            old(self).ownership(retired.record().obj),
+    {
+        self.lemma_no_active(&permit);
+        self.pools.lemma_all_contains_iff_keys();
+        let ghost obj = retired.record().obj;
+        let tracked mut claim = claim;
+        claim.entry.agree(&self.claims);
+        if self.unretired.contains_key(obj) {
+            let tracked retained = self.unretired.tracked_borrow(obj);
+            claim.entry.disjoint(&retained.entry);
+            assert(false);
+        }
+        claim.entry.update(&mut self.claims, None);
+        assert(self.claims@.dom() =~= self.allocated);
+        let tracked ownership = self.pools.reclaim(obj);
+        self.reclaimed.tracked_insert(obj, permit);
+        assert(self.pools.keys().union(self.reclaimed.dom()) =~= self.allocated);
+        assert(self.pools.keys().disjoint(self.reclaimed.dom()));
+        assert forall|other: nat| #[trigger] self.reclaimed.contains_key(other) implies {
+            let saved = self.reclaimed[other];
+            &&& saved.inv()
+            &&& saved.summary().retired.obj == other
+            &&& saved.summary().retired.domain == self.domain
+            &&& saved.summary().retired.retire_observation_registry == self.observations
+            &&& saved.summary().scheduler == self.scheduler
+            &&& saved.online() == self.online
+        } by {
+            if other != obj {
+                assert(old(self).reclaimed.contains_key(other));
+            }
+        };
+        assert forall|other: nat| #[trigger] self.claims@.contains_key(other) implies (
+        self.claims@[other] is Some) == self.pools.keys().contains(other) by {
+            if other != obj {
+                assert(old(self).claims@.contains_key(other));
+            }
+        };
+        assert(self.unretired.dom().subset_of(self.pools.keys()));
+        assert forall|other: nat| #[trigger] self.unretired.contains_key(other) implies {
+            let saved = self.unretired[other];
+            &&& saved.inv()
+            &&& saved.obj() == other
+            &&& saved.registry() == self.claims.id()
+            &&& self.claims@[other] == Some(saved.ptr())
+        } by {
+            assert(other != obj);
+            assert(old(self).unretired.contains_key(other));
+        };
+        ownership
+    }
+}
+
+} // verus!
diff --git a/ostd/specs/sync/rcu/retirement.rs b/ostd/specs/sync/rcu/retirement.rs
new file mode 100644
index 0000000000000000000000000000000000000000..399f8116eeb3edafb8c7f0989fbeb4acb0cddf3b
--- /dev/null
+++ b/ostd/specs/sync/rcu/retirement.rs
@@ -0,0 +1,388 @@
+// SPDX-License-Identifier: MPL-2.0
+//! Persistent root-retirement observations for CPU reports and callbacks.
+//!
+//! # Verified Properties
+//! A retirement consumes the root's previous linear registration and records
+//! the exact removal message in a persistent registry. All publications of that
+//! allocation precede the recorded timestamp. This certifies root detachment,
+//! not removal of incoming links and not permission to reclaim physical memory.
+use vstd::{
+    prelude::*,
+    resource::{
+        Loc,
+        map::{GhostMapAuth, GhostPersistentPointsTo},
+    },
+};
+use vstd_extra::{
+    atomic_irc11::{AtomicHistory, ThreadView as Irc11ThreadView},
+    ownership::Inv,
+    rcu_objects::{
+        RcuOwnedObject,
+        owned_root::{RcuRootOwnedGhost, rcu_owned_root_history_inv},
+    },
+};
+
+verus! {
+
+broadcast use vstd::set::group_set_lemmas;
+
+/// Description of a removal message; the description alone is not a certificate.
+pub ghost struct RcuRemovalObservation {
+    pub root: Loc,
+    pub timestamp: nat,
+    pub message_view: Irc11ThreadView,
+}
+
+impl RcuRemovalObservation {
+    /// A native view covers the removal's publication view.
+    pub open spec fn observed_by(self, view: Irc11ThreadView) -> bool {
+        view.contains(self.message_view)
+    }
+}
+
+/// Full identity of a retirement, including the registry that certified it.
+pub ghost struct RcuRetiredRecord {
+    pub domain: Loc,
+    pub obj: nat,
+    pub removal: RcuRemovalObservation,
+    pub retire_observation_registry: Loc,
+}
+
+/// Persistent certificate issued by one retirement authority.
+pub tracked struct RcuRetiredFact {
+    ghost domain: Loc,
+    observation: GhostPersistentPointsTo<nat, RcuRemovalObservation>,
+}
+
+impl RcuRetiredFact {
+    /// Domain of the detached allocation.
+    pub closed spec fn domain(self) -> Loc {
+        self.domain
+    }
+
+    /// Allocation identity, independent of its reused address.
+    pub closed spec fn obj(self) -> nat {
+        self.observation.key()
+    }
+
+    /// Exact removal message.
+    pub closed spec fn removal(self) -> RcuRemovalObservation {
+        self.observation.value()
+    }
+
+    /// Authority that certified this retirement.
+    pub closed spec fn retire_observation_registry(self) -> Loc {
+        self.observation.id()
+    }
+
+    /// This wrapper imposes no additional conditions beyond its private constructor.
+    pub closed spec fn wf(self) -> bool {
+        true
+    }
+
+    /// Complete retirement descriptor.
+    pub open spec fn record(self) -> RcuRetiredRecord {
+        RcuRetiredRecord {
+            domain: self.domain(),
+            obj: self.obj(),
+            removal: self.removal(),
+            retire_observation_registry: self.retire_observation_registry(),
+        }
+    }
+
+    /// Copies persistent evidence without copying the linear retirement resource.
+    pub proof fn tracked_duplicate(tracked &self) -> (tracked res: Self)
+        ensures
+            res.wf(),
+            res.record() == self.record(),
+            res.domain() == self.domain(),
+            res.obj() == self.obj(),
+            res.removal() == self.removal(),
+            res.retire_observation_registry() == self.retire_observation_registry(),
+    {
+        Self { domain: self.domain, observation: self.observation.duplicate() }
+    }
+
+    /// Agrees the certificate with its issuing authority.
+    pub proof fn lemma_agree(tracked &self, tracked authority: &RcuRetirementAuth)
+        requires
+            self.retire_observation_registry() == authority.id(),
+        ensures
+            authority.removals().contains_pair(self.obj(), self.removal()),
+    {
+        self.observation.agree(&authority.observations);
+    }
+}
+
+/// Linear registration retained after retirement, without physical permission.
+///
+/// There is deliberately no reclamation method: a completed grace period and
+/// the matching physical-permission registry are still required.
+#[verifier::reject_recursive_types(T)]
+pub tracked struct RcuRetiredRegistration<T> {
+    registration: RcuOwnedObject<T, ()>,
+    fact: RcuRetiredFact,
+}
+
+impl<T> RcuRetiredRegistration<T> {
+    /// Certified retirement associated with this linear registration.
+    pub closed spec fn record(self) -> RcuRetiredRecord {
+        self.fact.record()
+    }
+
+    /// Exact pointer, including provenance.
+    pub closed spec fn ptr(self) -> *mut T {
+        self.registration.block_info().ptr()
+    }
+}
+
+/// Monotone retirement registry for one typed root.
+pub tracked struct RcuRetirementAuth {
+    ghost domain: Loc,
+    observations: GhostMapAuth<nat, RcuRemovalObservation>,
+}
+
+impl RcuRetirementAuth {
+    /// Creates an empty registry; the domain is subsequently checked against each root.
+    pub proof fn tracked_new(domain: Loc) -> (tracked res: Self)
+        ensures
+            res.domain() == domain,
+            res.removals() == Map::<nat, RcuRemovalObservation>::empty(),
+    {
+        let tracked (observations, _) = GhostMapAuth::new(Map::empty());
+        Self { domain, observations }
+    }
+
+    /// Stable allocation domain.
+    pub closed spec fn domain(self) -> Loc {
+        self.domain
+    }
+
+    /// Stable identity of this observation registry.
+    pub closed spec fn id(self) -> Loc {
+        self.observations.id()
+    }
+
+    /// All certified removal messages.
+    pub closed spec fn removals(self) -> Map<nat, RcuRemovalObservation> {
+        self.observations@
+    }
+
+    /// Records a root replacement after checking all historical publications.
+    ///
+    /// The caller must keep these removals in the root atomic invariant, so
+    /// future publications cannot republish a retired allocation identity.
+    /// Linked-node retirement needs an additional no-incoming-links certificate.
+    pub proof fn tracked_retire_root<T>(
+        tracked &mut self,
+        tracked root: &RcuRootOwnedGhost<T, ()>,
+        tracked previous: RcuOwnedObject<T, ()>,
+        history: AtomicHistory<*mut T>,
+        removal: RcuRemovalObservation,
+    ) -> (tracked res: (RcuRetiredRegistration<T>, RcuRetiredFact))
+        requires
+            rcu_owned_root_history_inv(history, *root),
+            root.domain() == old(self).domain(),
+            previous.inv(),
+            previous.retire_perm().belongs_to(root.root().domain_auth()),
+            !old(self).removals().contains_key(previous.block_info().obj()),
+            removal.root == root.domain(),
+            root.root().current_timestamp() == removal.timestamp,
+            history.thread_view(removal.timestamp) == removal.message_view,
+            forall|ts: nat| #[trigger]
+                root.root().publications().contains_pair(ts, Some(previous.block_info().obj()))
+                    ==> ts < removal.timestamp,
+        ensures
+            final(self).domain() == old(self).domain(),
+            final(self).id() == old(self).id(),
+            final(self).removals() == old(self).removals().insert(
+                previous.block_info().obj(),
+                removal,
+            ),
+            res.0.ptr() == previous.block_info().ptr(),
+            res.0.record() == res.1.record(),
+            res.1.wf(),
+            res.1.domain() == old(self).domain(),
+            res.1.obj() == previous.block_info().obj(),
+            res.1.removal() == removal,
+            res.1.retire_observation_registry() == old(self).id(),
+    {
+        let tracked entry = self.observations.insert(previous.block_info().obj(), removal);
+        let tracked fact = RcuRetiredFact { domain: self.domain, observation: entry.persist() };
+        let tracked duplicate = fact.tracked_duplicate();
+        (RcuRetiredRegistration { registration: previous, fact }, duplicate)
+    }
+}
+
+/// A finite collection of persistent retirement facts.
+///
+/// The map key is the complete retirement record, rather than just an AId.
+/// This lets CPU-generation state accumulate facts from independent RCU
+/// domains without assuming that domain IDs determine observation-registry
+/// identities by pure equality alone.
+pub tracked struct RcuRetiredFacts {
+    facts: Map<RcuRetiredRecord, RcuRetiredFact>,
+}
+
+impl RcuRetiredFacts {
+    #[verifier::type_invariant]
+    closed spec fn type_inv(self) -> bool {
+        forall|record: RcuRetiredRecord| #[trigger]
+            self.facts.contains_key(record) ==> {
+                &&& self.facts[record].wf()
+                &&& self.facts[record].record() == record
+            }
+    }
+
+    /// Complete set of certified retirement records in this collection.
+    pub closed spec fn records(self) -> Set<RcuRetiredRecord> {
+        self.facts.dom()
+    }
+
+    pub closed spec fn contains(self, record: RcuRetiredRecord) -> bool {
+        self.facts.contains_key(record)
+    }
+
+    /// Every retained detachment observation is covered by `view`.
+    ///
+    /// The retirement facts themselves are persistent, but this predicate is
+    /// the separate weak-memory premise needed before a CPU report may publish
+    /// them to readers in a later quiescent generation.
+    pub open spec fn observed_by(self, view: Irc11ThreadView) -> bool {
+        forall|record: RcuRetiredRecord| #[trigger]
+            self.records().contains(record) ==> record.removal.observed_by(view)
+    }
+
+    /// Creates an empty retirement-fact collection.
+    pub proof fn empty() -> (tracked res: Self)
+        ensures
+            res.records() == Set::<RcuRetiredRecord>::empty(),
+    {
+        RcuRetiredFacts { facts: Map::tracked_empty() }
+    }
+
+    /// Borrows the persistent fact for one record.
+    pub proof fn tracked_borrow(tracked &self, record: RcuRetiredRecord) -> (tracked res:
+        &RcuRetiredFact)
+        requires
+            self.records().contains(record),
+        ensures
+            res.wf(),
+            res.record() == record,
+    {
+        use_type_invariant(self);
+        let tracked res = self.facts.tracked_borrow(record);
+        res
+    }
+
+    /// Inserts a persistent copy of `fact`.
+    pub proof fn tracked_insert(tracked &mut self, tracked fact: &RcuRetiredFact)
+        requires
+            fact.wf(),
+        ensures
+            final(self).records() == old(self).records().insert(fact.record()),
+            final(self).contains(fact.record()),
+    {
+        use_type_invariant(&*self);
+        let ghost record = fact.record();
+        let ghost old_records = self.facts.dom();
+        if !self.contains(record) {
+            let tracked duplicate = fact.tracked_duplicate();
+            self.facts.tracked_insert(record, duplicate);
+            assert forall|saved: RcuRetiredRecord| #[trigger]
+                self.facts.contains_key(saved) implies {
+                &&& self.facts[saved].wf()
+                &&& self.facts[saved].record() == saved
+            } by {
+                if saved == record {
+                } else {
+                    assert(old_records.contains(saved));
+                }
+            };
+        }
+    }
+
+    proof fn tracked_duplicate_keys(
+        tracked source: &Map<RcuRetiredRecord, RcuRetiredFact>,
+        keys: Set<RcuRetiredRecord>,
+    ) -> (tracked duplicates: Map<RcuRetiredRecord, RcuRetiredFact>)
+        requires
+            keys.subset_of(source.dom()),
+            forall|record: RcuRetiredRecord| #[trigger]
+                source.dom().contains(record) ==> {
+                    &&& source[record].wf()
+                    &&& source[record].record() == record
+                },
+        ensures
+            duplicates.dom() == keys,
+            forall|record: RcuRetiredRecord| #[trigger]
+                keys.contains(record) ==> {
+                    &&& duplicates[record].wf()
+                    &&& duplicates[record].record() == record
+                },
+        decreases keys.len(),
+    {
+        if keys.is_empty() {
+            Map::tracked_empty()
+        } else {
+            let ghost record = keys.choose();
+            let ghost rest = keys.remove(record);
+            let tracked mut duplicates = Self::tracked_duplicate_keys(source, rest);
+            let tracked fact = source.tracked_borrow(record);
+            let tracked duplicate = fact.tracked_duplicate();
+            duplicates.tracked_insert(record, duplicate);
+            assert(keys == rest.insert(record));
+            assert forall|saved: RcuRetiredRecord| #[trigger] keys.contains(saved) implies {
+                &&& duplicates[saved].wf()
+                &&& duplicates[saved].record() == saved
+            } by {
+                if saved == record {
+                } else {
+                    assert(rest.contains(saved));
+                }
+            };
+            duplicates
+        }
+    }
+
+    /// Duplicates this persistent fact collection.
+    pub proof fn tracked_duplicate(tracked &self) -> (tracked res: Self)
+        ensures
+            res.records() == self.records(),
+    {
+        use_type_invariant(self);
+        let tracked facts = Self::tracked_duplicate_keys(&self.facts, self.facts.dom());
+        RcuRetiredFacts { facts }
+    }
+
+    proof fn tracked_merge_keys(
+        tracked target: &mut RcuRetiredFacts,
+        tracked source: &RcuRetiredFacts,
+        keys: Set<RcuRetiredRecord>,
+    )
+        requires
+            keys.subset_of(source.records()),
+        ensures
+            final(target).records() == old(target).records().union(keys),
+        decreases keys.len(),
+    {
+        if !keys.is_empty() {
+            let ghost record = keys.choose();
+            let ghost rest = keys.remove(record);
+            let tracked fact = source.tracked_borrow(record);
+            target.tracked_insert(fact);
+            Self::tracked_merge_keys(target, source, rest);
+            assert(keys == rest.insert(record));
+        }
+    }
+
+    /// Adds persistent copies of all facts in `other`.
+    pub proof fn tracked_merge(tracked &mut self, tracked other: &RcuRetiredFacts)
+        ensures
+            final(self).records() == old(self).records().union(other.records()),
+    {
+        Self::tracked_merge_keys(self, other, other.records());
+    }
+}
+
+} // verus!
diff --git a/ostd/specs/sync/rcu/traversal.rs b/ostd/specs/sync/rcu/traversal.rs
new file mode 100644
index 0000000000000000000000000000000000000000..577ae541bd1cf82ba8a36d313726f47453e03843
--- /dev/null
+++ b/ostd/specs/sync/rcu/traversal.rs
@@ -0,0 +1,406 @@
+// SPDX-License-Identifier: MPL-2.0
+//! Paper-style Guard / SeenRemoved reasoning for historical list edges.
+//!
+//! # Verified Properties
+//! Allocation identity, not address, indexes every edge. Native load coherence
+//! and a protected predecessor rule out following an observed-dead edge into
+//! the removed set. Retirement requires every historical incoming edge dead;
+//! overwriting one of several incoming edges is insufficient. This is topology
+//! evidence only: physical borrowing still requires the CPU/lease protocol.
+use vstd::{prelude::*, resource::Loc};
+use vstd_extra::{
+    atomic_irc11::{AtomicHistory, AtomicPointsTo, ThreadView, load_acquire},
+    ownership::Inv,
+    rcu_objects::RcuBlockInfo,
+};
+
+verus! {
+
+broadcast use {vstd::set::group_set_lemmas, vstd::atomic_weak::group_view_history};
+
+/// AId includes the allocation registry, so unrelated roots cannot alias IDs.
+pub ghost struct AllocationId {
+    pub domain: Loc,
+    pub object: nat,
+}
+
+/// Historical edge: predecessor allocation and its native publication timestamp.
+pub type LinkEdge = (AllocationId, nat);
+
+/// Allocation-indexed historical topology. Timestamps may have arbitrary gaps.
+#[verifier::reject_recursive_types(T)]
+pub ghost struct LinkGraph<T> {
+    pub objects: Map<AllocationId, *mut T>,
+    pub events: Map<LinkEdge, Option<AllocationId>>,
+    pub incoming: Map<AllocationId, Set<LinkEdge>>,
+    pub removed: Set<AllocationId>,
+}
+
+impl<T> Inv for LinkGraph<T> {
+    open spec fn inv(self) -> bool {
+        &&& self.incoming.dom() == self.objects.dom()
+        &&& self.removed.subset_of(self.objects.dom())
+        &&& forall|edge: LinkEdge| #[trigger]
+            self.events.contains_key(edge) ==> {
+                &&& self.objects.contains_key(edge.0)
+                &&& self.events[edge] matches Some(child) ==> {
+                    &&& self.objects.contains_key(child)
+                    &&& self.incoming[child].contains(edge)
+                }
+            }
+    }
+}
+
+impl<T> LinkGraph<T> {
+    pub open spec fn empty() -> Self {
+        Self {
+            objects: Map::empty(),
+            events: Map::empty(),
+            incoming: Map::empty(),
+            removed: Set::empty(),
+        }
+    }
+
+    /// Registers an actual typed block certificate, retaining full pointer provenance.
+    pub proof fn register(self, tracked info: &RcuBlockInfo<T>) -> (res: Self)
+        requires
+            self.inv(),
+            info.inv(),
+            !self.objects.contains_key(AllocationId { domain: info.domain(), object: info.obj() }),
+        ensures
+            res.inv(),
+            res.events == self.events,
+            res.removed == self.removed,
+            res.objects == self.objects.insert(
+                AllocationId { domain: info.domain(), object: info.obj() },
+                info.ptr(),
+            ),
+            res.incoming == self.incoming.insert(
+                AllocationId { domain: info.domain(), object: info.obj() },
+                Set::empty(),
+            ),
+    {
+        let id = AllocationId { domain: info.domain(), object: info.obj() };
+        Self {
+            objects: self.objects.insert(id, info.ptr()),
+            incoming: self.incoming.insert(id, Set::empty()),
+            ..self
+        }
+    }
+
+    /// Appends a publication or null unlink. Removed allocations cannot be republished.
+    pub proof fn publish(
+        self,
+        source: AllocationId,
+        timestamp: nat,
+        child: Option<AllocationId>,
+    ) -> (res: Self)
+        requires
+            self.inv(),
+            self.objects.contains_key(source),
+            !self.removed.contains(source),
+            !self.events.contains_key((source, timestamp)),
+            child matches Some(id) ==> self.objects.contains_key(id) && !self.removed.contains(id),
+        ensures
+            res.inv(),
+            res.objects == self.objects,
+            res.removed == self.removed,
+            res.events == self.events.insert((source, timestamp), child),
+            res.incoming == match child {
+                Some(id) => self.incoming.insert(id, self.incoming[id].insert((source, timestamp))),
+                None => self.incoming,
+            },
+    {
+        let incoming = match child {
+            Some(id) => self.incoming.insert(id, self.incoming[id].insert((source, timestamp))),
+            None => self.incoming,
+        };
+        let result = Self {
+            incoming,
+            events: self.events.insert((source, timestamp), child),
+            ..self
+        };
+        assert(result.incoming.dom() =~= self.incoming.dom());
+        assert forall|edge: LinkEdge| #[trigger] result.events.contains_key(edge) implies {
+            &&& result.objects.contains_key(edge.0)
+            &&& result.events[edge] matches Some(id) ==> {
+                &&& result.objects.contains_key(id)
+                &&& result.incoming[id].contains(edge)
+            }
+        } by {
+            if edge != (source, timestamp) {
+                assert(self.events.contains_key(edge));
+            }
+        };
+        result
+    }
+
+    /// Relates all messages of one native link location to exact allocation IDs.
+    pub open spec fn native_history(
+        self,
+        source: AllocationId,
+        history: AtomicHistory<*mut T>,
+    ) -> bool {
+        forall|timestamp: nat|
+            history.contains_timestamp(timestamp) ==> {
+                &&& self.events.contains_key((source, timestamp))
+                &&& match #[trigger] self.events[(source, timestamp)] {
+                    Some(child) => equal(history.value(timestamp), self.objects[child]),
+                    None => history.value(timestamp).addr() == 0,
+                }
+            }
+    }
+}
+
+/// SeenRemoved(D, LV): observed removals and per-predecessor link lower bounds.
+pub ghost struct SeenRemoved {
+    pub removed: Set<AllocationId>,
+    pub links: Map<AllocationId, nat>,
+}
+
+impl SeenRemoved {
+    pub open spec fn seen_at(self, source: AllocationId) -> nat {
+        if self.links.contains_key(source) {
+            self.links[source]
+        } else {
+            0
+        }
+    }
+
+    pub open spec fn dead(self, edge: LinkEdge) -> bool {
+        self.removed.contains(edge.0) || self.seen_at(edge.0) > edge.1
+    }
+
+    pub open spec fn sound<T>(self, graph: LinkGraph<T>) -> bool {
+        &&& self.bounds(graph)
+        &&& self.removed.subset_of(graph.removed)
+        &&& forall|child: AllocationId| #[trigger]
+            self.removed.contains(child) ==> {
+                &&& graph.incoming.contains_key(child)
+                &&& forall|edge: LinkEdge| #[trigger]
+                    graph.incoming[child].contains(edge) ==> self.dead(edge)
+            }
+    }
+
+    /// Every link lower bound names a real event, never a fabricated future timestamp.
+    pub open spec fn bounds<T>(self, graph: LinkGraph<T>) -> bool {
+        forall|source: AllocationId| #[trigger]
+            self.links.contains_key(source) ==> graph.events.contains_key(
+                (source, self.links[source]),
+            )
+    }
+
+    /// Joins a coherent link observation without losing any previously dead edge.
+    pub proof fn observe<T>(
+        self,
+        graph: LinkGraph<T>,
+        source: AllocationId,
+        timestamp: nat,
+    ) -> (res: Self)
+        requires
+            self.sound(graph),
+            self.seen_at(source) <= timestamp,
+            graph.events.contains_key((source, timestamp)),
+        ensures
+            res.sound(graph),
+            res.removed == self.removed,
+            res.links == self.links.insert(source, timestamp),
+    {
+        let result = Self { removed: self.removed, links: self.links.insert(source, timestamp) };
+        assert forall|child: AllocationId| #[trigger] result.removed.contains(child) implies {
+            &&& graph.incoming.contains_key(child)
+            &&& forall|edge: LinkEdge| #[trigger]
+                graph.incoming[child].contains(edge) ==> result.dead(edge)
+        } by {
+            assert forall|edge: LinkEdge| #[trigger]
+                graph.incoming[child].contains(edge) implies result.dead(edge) by {
+                assert(self.dead(edge));
+                assert(result.seen_at(edge.0) >= self.seen_at(edge.0));
+            };
+        };
+        result
+    }
+
+    /// The topology retirement rule consumes evidence for every historical incoming edge.
+    pub proof fn retire<T>(self, graph: LinkGraph<T>, child: AllocationId) -> (res: (
+        Self,
+        LinkGraph<T>,
+    ))
+        requires
+            graph.inv(),
+            self.sound(graph),
+            graph.objects.contains_key(child),
+            forall|edge: LinkEdge| #[trigger]
+                graph.incoming[child].contains(edge) ==> self.dead(edge),
+        ensures
+            res.1.inv(),
+            res.0.sound(res.1),
+            res.0.removed == self.removed.insert(child),
+            res.0.links == self.links,
+            res.1.removed == graph.removed.insert(child),
+            res.1.objects == graph.objects,
+            res.1.events == graph.events,
+            res.1.incoming == graph.incoming,
+    {
+        let observed = Self { removed: self.removed.insert(child), links: self.links };
+        let graph = LinkGraph { removed: graph.removed.insert(child), ..graph };
+        assert forall|id: AllocationId| #[trigger] observed.removed.contains(id) implies {
+            &&& graph.incoming.contains_key(id)
+            &&& forall|edge: LinkEdge| #[trigger]
+                graph.incoming[id].contains(edge) ==> observed.dead(edge)
+        } by {
+            assert forall|edge: LinkEdge| #[trigger]
+                graph.incoming[id].contains(edge) implies observed.dead(edge) by {
+                assert(self.dead(edge));
+            };
+        };
+        (observed, graph)
+    }
+}
+
+/// Guard(t, X, G), with allocation-indexed protection and an entry-time expired set.
+pub ghost struct TraversalGuard {
+    pub reader: Loc,
+    pub expired: Set<AllocationId>,
+    pub protected: Set<AllocationId>,
+    pub observed: SeenRemoved,
+}
+
+impl TraversalGuard {
+    pub open spec fn inv<T>(self, graph: LinkGraph<T>) -> bool {
+        &&& graph.inv()
+        &&& self.observed.sound(graph)
+        &&& self.expired.subset_of(self.observed.removed)
+        &&& self.protected.disjoint(self.observed.removed)
+        &&& self.protected.subset_of(graph.objects.dom())
+    }
+
+    /// Native coherence plus historical-edge identity proves the child's non-expiration.
+    /// `observed_view` is an actual previously seen message view, not a fabricated token.
+    pub proof fn protect_link<T>(
+        self,
+        graph: LinkGraph<T>,
+        source: AllocationId,
+        child: AllocationId,
+        tracked points_to: &AtomicPointsTo<*mut T>,
+        start: ThreadView,
+        after: ThreadView,
+        ptr: *mut T,
+        timestamp: nat,
+        message_view: ThreadView,
+        observed_view: ThreadView,
+    ) -> (res: Self)
+        requires
+            self.inv(graph),
+            self.protected.contains(source),
+            graph.native_history(source, points_to.hist()),
+            graph.events.contains_pair((source, timestamp), Some(child)),
+            load_acquire(*points_to, start, after, ptr, timestamp, message_view),
+            self.observed.links.contains_key(source) ==> {
+                &&& start.contains(observed_view)
+                &&& points_to.get_timestamp(observed_view) == Some(self.observed.seen_at(source))
+            },
+        ensures
+            res.inv(graph),
+            res.reader == self.reader,
+            res.expired == self.expired,
+            res.protected == self.protected.insert(child),
+            res.observed.removed == self.observed.removed,
+            res.observed.links == self.observed.links.insert(source, timestamp),
+            !self.expired.contains(child),
+            !self.observed.removed.contains(child),
+            equal(ptr, graph.objects[child]),
+    {
+        if self.observed.links.contains_key(source) {
+            points_to.get_timestamp_monotonic(start, observed_view);
+        }
+        assert(self.observed.seen_at(source) <= timestamp);
+        assert(graph.incoming[child].contains((source, timestamp)));
+        if self.observed.removed.contains(child) {
+            assert(self.observed.dead((source, timestamp)));
+            assert(false);
+        }
+        let observed = self.observed.observe(graph, source, timestamp);
+        Self { protected: self.protected.insert(child), observed, ..self }
+    }
+}
+
+/// A single still-live incoming edge prevents retirement, regardless of other unlinks.
+pub proof fn live_incoming_blocks_retire<T>(
+    graph: LinkGraph<T>,
+    observed: SeenRemoved,
+    child: AllocationId,
+    edge: LinkEdge,
+)
+    requires
+        graph.incoming.contains_key(child),
+        graph.incoming[child].contains(edge),
+        observed.bounds(graph),
+        !observed.removed.contains(edge.0),
+        forall|timestamp: nat| #[trigger]
+            graph.events.contains_key((edge.0, timestamp)) ==> timestamp <= edge.1,
+    ensures
+        !observed.dead(edge),
+        !(forall|incoming: LinkEdge| #[trigger]
+            graph.incoming[child].contains(incoming) ==> observed.dead(incoming)),
+{
+    if observed.links.contains_key(edge.0) {
+        assert(graph.events.contains_key((edge.0, observed.links[edge.0])));
+    }
+}
+
+/// Two incoming edges, gapped timestamps, unlink, retirement, and ABA identity regression.
+pub proof fn linked_list_unlink_regression<T>(
+    tracked source: &RcuBlockInfo<T>,
+    tracked second_source: &RcuBlockInfo<T>,
+    tracked child: &RcuBlockInfo<T>,
+    tracked reused: &RcuBlockInfo<T>,
+)
+    requires
+        source.inv(),
+        second_source.inv(),
+        child.inv(),
+        reused.inv(),
+        source.domain() == second_source.domain(),
+        source.domain() == child.domain(),
+        source.domain() == reused.domain(),
+        source.obj() < second_source.obj() < child.obj() < reused.obj(),
+        child.ptr().addr() == reused.ptr().addr(),
+{
+    let source_id = AllocationId { domain: source.domain(), object: source.obj() };
+    let second_id = AllocationId { domain: second_source.domain(), object: second_source.obj() };
+    let child_id = AllocationId { domain: child.domain(), object: child.obj() };
+    let reused_id = AllocationId { domain: reused.domain(), object: reused.obj() };
+    let graph = LinkGraph::empty().register(source);
+    let graph = graph.register(second_source);
+    let graph = graph.register(child);
+    let graph = graph.register(reused);
+    let graph = graph.publish(source_id, 3, Some(child_id));
+    let graph = graph.publish(second_id, 11, Some(child_id));
+    let graph = graph.publish(source_id, 8, None);
+    let observed = SeenRemoved { removed: Set::empty(), links: Map::empty().insert(source_id, 8) };
+    live_incoming_blocks_retire(graph, observed, child_id, (second_id, 11));
+    let graph = graph.publish(second_id, 19, None);
+    let observed = observed.observe(graph, second_id, 19);
+    let (observed, graph) = observed.retire(graph, child_id);
+    let graph = graph.publish(source_id, 27, Some(reused_id));
+    assert(graph.events[(source_id, 3)] == Some(child_id));
+    assert(graph.events[(source_id, 27)] == Some(reused_id));
+    assert(child_id != reused_id);
+    assert(graph.removed.contains(child_id) && !graph.removed.contains(reused_id));
+}
+
+/// Constructs the regression's certificates; its aliasing addresses grant no memory access.
+proof fn constructed_unlink_regression<T>(ptr: *mut T)
+    requires
+        ptr.addr() != 0,
+{
+    let tracked mut domain = vstd_extra::rcu_objects::RcuDomainAuth::tracked_new();
+    let tracked (source, _) = domain.tracked_register(ptr);
+    let tracked (second, _) = domain.tracked_register(ptr);
+    let tracked (child, _) = domain.tracked_register(ptr);
+    let tracked (reused, _) = domain.tracked_register(ptr);
+    linked_list_unlink_regression(&source, &second, &child, &reused);
+}
+
+} // verus!
