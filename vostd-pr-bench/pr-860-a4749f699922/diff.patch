+// SPDX-License-Identifier: MPL-2.0
+//! Grace-period batches and per-callback reclamation evidence.
+//!
+//! # Verified Properties
+//! A batch closes only after every CPU in its fixed online set supplies a
+//! canonical closed-generation report covering every callback's retirement.
+//! Reports from another scheduler or an earlier view do not satisfy the
+//! invariant. Completing a batch yields evidence, not physical ownership.
+use vstd::{prelude::*, resource::Loc};
+use vstd_extra::{atomic_irc11::ThreadView, ownership::Inv};
+
+use super::{
+    cpu::CpuRcuClosedGeneration,
+    retirement::{RcuRetiredFact, RcuRetiredRecord},
+};
+use crate::cpu::CpuId;
+
+verus! {
+
+broadcast use {vstd::set::group_set_lemmas, vstd::thread_view::group_thread_view_axioms};
+
+/// Callback identity and observations that every reporting CPU must cover.
+pub ghost struct RcuCallbackSummary {
+    pub scheduler: Loc,
+    pub retired: RcuRetiredRecord,
+    pub epoch: nat,
+    pub retire_view: ThreadView,
+}
+
+/// Persistent completion evidence for one fixed batch.
+pub tracked struct CompletedGracePeriod {
+    ghost scheduler: Loc,
+    ghost epoch: nat,
+    ghost online: Set<CpuId>,
+    ghost callbacks: Seq<RcuCallbackSummary>,
+    reports: Map<CpuId, CpuRcuClosedGeneration>,
+}
+
+/// Object-specific authorization; physical permission is recovered separately.
+pub tracked struct RcuReclaimPermit {
+    ghost summary: RcuCallbackSummary,
+    ghost online: Set<CpuId>,
+    fact: RcuRetiredFact,
+    reports: Map<CpuId, CpuRcuClosedGeneration>,
+}
+
+/// Whether a CPU report covers a particular queued callback.
+pub open spec fn report_covers(
+    report: CpuRcuClosedGeneration,
+    callback: RcuCallbackSummary,
+) -> bool {
+    &&& report.wf()
+    &&& report.scheduler() == callback.scheduler
+    &&& report.view().contains(callback.retire_view)
+    &&& report.known_retired().contains(callback.retired)
+}
+
+/// Reports collected while a single epoch is active.
+pub tracked struct RcuGracePeriod {
+    ghost scheduler: Loc,
+    ghost epoch: nat,
+    ghost online: Set<CpuId>,
+    ghost callbacks: Seq<RcuCallbackSummary>,
+    reports: Map<CpuId, CpuRcuClosedGeneration>,
+}
+
+impl Inv for RcuGracePeriod {
+    closed spec fn inv(self) -> bool {
+        &&& self.reports.dom().subset_of(self.online)
+        &&& forall|i: int|
+            0 <= i < self.callbacks.len() ==> {
+                let callback = #[trigger] self.callbacks[i];
+                &&& callback.epoch == self.epoch
+                &&& callback.scheduler == self.scheduler
+                &&& callback.retired.removal.observed_by(callback.retire_view)
+            }
+        &&& forall|cpu: CpuId| #[trigger]
+            self.reports.contains_key(cpu) ==> {
+                &&& self.reports[cpu].cpu() == cpu
+                &&& self.reports[cpu].wf()
+                &&& self.reports[cpu].scheduler() == self.scheduler
+                &&& forall|i: int|
+                    0 <= i < self.callbacks.len() ==> report_covers(
+                        self.reports[cpu],
+                        #[trigger] self.callbacks[i],
+                    )
+            }
+    }
+}
+
+impl RcuGracePeriod {
+    /// Starts an epoch without reusing any report from an earlier batch.
+    pub proof fn tracked_start(
+        scheduler: Loc,
+        epoch: nat,
+        online: Set<CpuId>,
+        callbacks: Seq<RcuCallbackSummary>,
+    ) -> (tracked res: Self)
+        requires
+            forall|i: int|
+                0 <= i < callbacks.len() ==> {
+                    let callback = #[trigger] callbacks[i];
+                    &&& callback.epoch == epoch
+                    &&& callback.scheduler == scheduler
+                    &&& callback.retired.removal.observed_by(callback.retire_view)
+                },
+        ensures
+            res.inv(),
+            res.scheduler() == scheduler,
+            res.epoch() == epoch,
+            res.online() == online,
+            res.callbacks() == callbacks,
+            res.reported() == Set::<CpuId>::empty(),
+    {
+        Self { scheduler, epoch, online, callbacks, reports: Map::tracked_empty() }
+    }
+
+    /// Scheduler registry that owns the reporting CPU participants.
+    pub closed spec fn scheduler(self) -> Loc {
+        self.scheduler
+    }
+
+    /// Global batch epoch, distinct from each CPU's reader generation.
+    pub closed spec fn epoch(self) -> nat {
+        self.epoch
+    }
+
+    /// Stable online set for this batch; hotplug is not modeled.
+    pub closed spec fn online(self) -> Set<CpuId> {
+        self.online
+    }
+
+    /// Callbacks assigned to this batch before it started.
+    pub closed spec fn callbacks(self) -> Seq<RcuCallbackSummary> {
+        self.callbacks
+    }
+
+    /// Exact ghost counterpart of the monitor's CPU report mask.
+    pub closed spec fn reported(self) -> Set<CpuId> {
+        self.reports.dom()
+    }
+
+    /// A well-formed active mask never contains an unconfigured CPU.
+    pub proof fn lemma_reported_subset(self)
+        requires
+            self.inv(),
+        ensures
+            self.reported().subset_of(self.online()),
+    {
+    }
+
+    /// Accepts a report only after checking all retire views in the active batch.
+    pub proof fn tracked_report(tracked &mut self, tracked report: CpuRcuClosedGeneration)
+        requires
+            old(self).inv(),
+            old(self).online().contains(report.cpu()),
+            report.wf(),
+            report.scheduler() == old(self).scheduler(),
+            forall|i: int|
+                0 <= i < old(self).callbacks().len() ==> report_covers(
+                    report,
+                    #[trigger] old(self).callbacks()[i],
+                ),
+        ensures
+            final(self).inv(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).epoch() == old(self).epoch(),
+            final(self).online() == old(self).online(),
+            final(self).callbacks() == old(self).callbacks(),
+            final(self).reported() == old(self).reported().insert(report.cpu()),
+    {
+        let ghost cpu = report.cpu();
+        self.reports.tracked_insert(cpu, report);
+        assert forall|other: CpuId| #[trigger] self.reports.contains_key(other) implies {
+            &&& self.reports[other].cpu() == other
+            &&& self.reports[other].wf()
+            &&& self.reports[other].scheduler() == self.scheduler
+            &&& forall|i: int|
+                0 <= i < self.callbacks.len() ==> report_covers(
+                    self.reports[other],
+                    #[trigger] self.callbacks[i],
+                )
+        } by {
+            if other != cpu {
+                assert(old(self).reports.contains_key(other));
+            }
+            assert forall|i: int| 0 <= i < self.callbacks.len() implies report_covers(
+                self.reports[other],
+                #[trigger] self.callbacks[i],
+            ) by {
+                if other == cpu {
+                    assert(self.reports[other] == report);
+                    assert(report_covers(report, old(self).callbacks()[i]));
+                } else {
+                    assert(report_covers(old(self).reports[other], old(self).callbacks[i]));
+                    assert(self.reports[other] == old(self).reports[other]);
+                }
+                assert(self.callbacks[i] == old(self).callbacks[i]);
+            };
+        };
+    }
+
+    /// Consumes a fully reported epoch without granting any physical ownership.
+    pub proof fn tracked_complete(tracked self) -> (tracked res: CompletedGracePeriod)
+        requires
+            self.inv(),
+            self.reported() == self.online(),
+        ensures
+            res.inv(),
+            res.scheduler() == self.scheduler(),
+            res.epoch() == self.epoch(),
+            res.online() == self.online(),
+            res.callbacks() == self.callbacks(),
+    {
+        CompletedGracePeriod {
+            scheduler: self.scheduler,
+            epoch: self.epoch,
+            online: self.online,
+            callbacks: self.callbacks,
+            reports: self.reports,
+        }
+    }
+}
+
+impl Inv for CompletedGracePeriod {
+    closed spec fn inv(self) -> bool {
+        &&& self.reports.dom() == self.online
+        &&& forall|i: int|
+            0 <= i < self.callbacks.len() ==> {
+                let callback = #[trigger] self.callbacks[i];
+                &&& callback.scheduler == self.scheduler
+                &&& callback.epoch == self.epoch
+                &&& callback.retired.removal.observed_by(callback.retire_view)
+            }
+        &&& forall|cpu: CpuId| #[trigger]
+            self.reports.contains_key(cpu) ==> {
+                &&& self.reports[cpu].cpu() == cpu
+                &&& self.reports[cpu].wf()
+                &&& self.reports[cpu].scheduler() == self.scheduler
+                &&& forall|i: int|
+                    0 <= i < self.callbacks.len() ==> report_covers(
+                        self.reports[cpu],
+                        #[trigger] self.callbacks[i],
+                    )
+            }
+    }
+}
+
+impl CompletedGracePeriod {
+    /// Scheduler registry whose participants supplied this batch's reports.
+    pub closed spec fn scheduler(self) -> Loc {
+        self.scheduler
+    }
+
+    /// Completed batch epoch.
+    pub closed spec fn epoch(self) -> nat {
+        self.epoch
+    }
+
+    /// CPUs covered by completion.
+    pub closed spec fn online(self) -> Set<CpuId> {
+        self.online
+    }
+
+    /// Exact batch whose callbacks can be authorized.
+    pub closed spec fn callbacks(self) -> Seq<RcuCallbackSummary> {
+        self.callbacks
+    }
+
+    /// Authorizes a batch member only with its matching retirement certificate.
+    pub proof fn tracked_authorize(
+        tracked &self,
+        index: int,
+        tracked fact: &RcuRetiredFact,
+    ) -> (tracked res: RcuReclaimPermit)
+        requires
+            self.inv(),
+            0 <= index < self.callbacks().len(),
+            fact.record() == self.callbacks()[index].retired,
+        ensures
+            res.inv(),
+            res.summary() == self.callbacks()[index],
+            res.online() == self.online(),
+    {
+        let tracked reports = duplicate_reports(&self.reports, self.online);
+        let tracked fact = fact.tracked_duplicate();
+        RcuReclaimPermit { summary: self.callbacks[index], online: self.online, fact, reports }
+    }
+}
+
+impl Inv for RcuReclaimPermit {
+    closed spec fn inv(self) -> bool {
+        &&& self.fact.record() == self.summary.retired
+        &&& self.summary.retired.removal.observed_by(self.summary.retire_view)
+        &&& self.reports.dom() == self.online
+        &&& forall|cpu: CpuId| #[trigger]
+            self.reports.contains_key(cpu) ==> {
+                &&& self.reports[cpu].cpu() == cpu
+                &&& report_covers(self.reports[cpu], self.summary)
+            }
+    }
+}
+
+impl RcuReclaimPermit {
+    /// Callback identity and retirement view covered by this permit.
+    pub closed spec fn summary(self) -> RcuCallbackSummary {
+        self.summary
+    }
+
+    /// Fixed CPU set whose reader generations were closed.
+    pub closed spec fn online(self) -> Set<CpuId> {
+        self.online
+    }
+
+    /// Borrows one canonical report to exclude a live physical lease.
+    pub proof fn tracked_report(tracked &self, cpu: CpuId) -> (tracked res: &CpuRcuClosedGeneration)
+        requires
+            self.inv(),
+            self.online().contains(cpu),
+        ensures
+            res.cpu() == cpu,
+            report_covers(*res, self.summary()),
+    {
+        self.reports.tracked_borrow(cpu)
+    }
+}
+
+// Copy only idempotent reports. No live-reader fraction is duplicated.
+proof fn duplicate_reports(
+    tracked source: &Map<CpuId, CpuRcuClosedGeneration>,
+    keys: Set<CpuId>,
+) -> (tracked res: Map<CpuId, CpuRcuClosedGeneration>)
+    requires
+        keys.subset_of(source.dom()),
+        forall|cpu: CpuId| #[trigger] source.contains_key(cpu) ==> source[cpu].wf(),
+    ensures
+        res.dom() == keys,
+        forall|cpu: CpuId| #[trigger]
+            res.contains_key(cpu) ==> {
+                &&& res[cpu].wf()
+                &&& res[cpu].cpu() == source[cpu].cpu()
+                &&& res[cpu].scheduler() == source[cpu].scheduler()
+                &&& res[cpu].participant_id() == source[cpu].participant_id()
+                &&& res[cpu].closed_generation() == source[cpu].closed_generation()
+                &&& res[cpu].view() == source[cpu].view()
+                &&& res[cpu].known_retired() == source[cpu].known_retired()
+            },
+    decreases keys.len(),
+{
+    if keys.is_empty() {
+        Map::tracked_empty()
+    } else {
+        let ghost cpu = keys.choose();
+        let tracked mut res = duplicate_reports(source, keys.remove(cpu));
+        let tracked report = source.tracked_borrow(cpu).tracked_duplicate_from_ref();
+        res.tracked_insert(cpu, report);
+        assert(keys == keys.remove(cpu).insert(cpu));
+        res
+    }
+}
+
+} // verus!
diff --git a/ostd/specs/sync/rcu/link.rs b/ostd/specs/sync/rcu/link.rs
new file mode 100644
index 0000000000000000000000000000000000000000..adaa3f0f882e2458d203a0ab4ad5b2e904e84d85
--- /dev/null
+++ b/ostd/specs/sync/rcu/link.rs
@@ -0,0 +1,252 @@
+// SPDX-License-Identifier: MPL-2.0
+//! Single-owner links: the historical topology of an embedded owning RCU slot.
+//!
+//! # Verified Properties
+//! The graph is derived from the slot's complete native publication history,
+//! never supplied by a reader. Each allocation is owned by this slot; this is
+//! not the multi-incoming-edge shared-node representation. The source identity
+//! comes from a physically protected predecessor in a different allocation
+//! domain. Its pointer in this graph is only a heterogeneous identity label.
+use vstd::{prelude::*, resource::Loc};
+use vstd_extra::{
+    atomic_irc11::{AtomicHistory, AtomicPointsTo, ThreadView},
+    ownership::Inv,
+    rcu_objects::owned_root::{RcuRootOwnedGhost, rcu_owned_root_history_inv},
+};
+
+use super::{
+    retirement::RcuRemovalObservation,
+    traversal::{AllocationId, LinkEdge, LinkGraph, SeenRemoved, TraversalGuard},
+};
+
+verus! {
+
+broadcast use {
+    vstd::set::group_set_lemmas,
+    vstd::set::Set::lemma_map_by_contains,
+    vstd::atomic_weak::group_view_history,
+};
+
+/// Injectively lifts this slot's finite object set into allocation identities.
+pub open spec fn allocation_ids(domain: Loc, objects: Set<nat>) -> Set<AllocationId> {
+    objects.map_by(|obj: nat| AllocationId { domain, object: obj }, |id: AllocationId| id.object)
+}
+
+/// Topology and protection returned by the very load that issued a physical lease.
+#[verifier::reject_recursive_types(T)]
+pub ghost struct RcuLinkObservation<T> {
+    pub graph: LinkGraph<T>,
+    pub guard: TraversalGuard,
+    pub source: AllocationId,
+    pub child: Option<AllocationId>,
+    pub timestamp: nat,
+    pub reader: Loc,
+    pub generation: nat,
+    pub start_view: ThreadView,
+}
+
+impl<T> Inv for RcuLinkObservation<T> {
+    open spec fn inv(self) -> bool {
+        &&& self.guard.inv(self.graph)
+        &&& self.guard.reader == self.reader
+        &&& self.guard.protected.contains(self.source)
+        &&& self.graph.events.contains_pair((self.source, self.timestamp), self.child)
+        &&& self.guard.observed.links.contains_pair(self.source, self.timestamp)
+        &&& self.child matches Some(child) ==> {
+            &&& self.guard.protected.contains(child)
+            &&& !self.guard.expired.contains(child)
+            &&& !self.guard.observed.removed.contains(child)
+        }
+    }
+}
+
+/// No-incoming-edge evidence retained alongside the exact linear retirement ticket.
+#[verifier::reject_recursive_types(T)]
+pub ghost struct RcuLinkRemoval<T> {
+    pub graph: LinkGraph<T>,
+    pub observed: SeenRemoved,
+    pub source: AllocationId,
+    pub child: AllocationId,
+    pub removal: RcuRemovalObservation,
+}
+
+impl<T> Inv for RcuLinkRemoval<T> {
+    open spec fn inv(self) -> bool {
+        &&& self.graph.inv()
+        &&& self.observed.sound(self.graph)
+        &&& self.observed.removed.contains(self.child)
+        &&& self.observed.links.contains_pair(self.source, self.removal.timestamp)
+        &&& self.graph.events.contains_pair((self.source, self.removal.timestamp), None)
+        &&& self.child.domain == self.removal.root
+        &&& forall|edge: LinkEdge| #[trigger]
+            self.graph.incoming[self.child].contains(edge) ==> self.observed.dead(edge)
+    }
+}
+
+/// The exact one-source graph represented by an owning slot's typed history.
+pub open spec fn owned_link_graph<T>(
+    root: RcuRootOwnedGhost<T, ()>,
+    removed: Set<nat>,
+    source: AllocationId,
+    source_ptr: *mut T,
+) -> LinkGraph<T> {
+    let objects = Map::new(
+        allocation_ids(root.domain(), root.infos().dom()).insert(source),
+        |id: AllocationId|
+            if id == source {
+                source_ptr
+            } else {
+                root.infos()[id.object].ptr()
+            },
+    );
+    let events = Map::new(
+        root.root().publications().dom().map_by(|ts: nat| (source, ts), |edge: LinkEdge| edge.1),
+        |edge: LinkEdge|
+            match root.root().publications()[edge.1] {
+                Some(obj) => Some(AllocationId { domain: root.domain(), object: obj }),
+                None => None,
+            },
+    );
+    LinkGraph {
+        objects,
+        events,
+        incoming: Map::new(
+            objects.dom(),
+            |id: AllocationId| events.dom().filter(|edge: LinkEdge| events[edge] == Some(id)),
+        ),
+        removed: allocation_ids(root.domain(), removed),
+    }
+}
+
+/// Refines every native message, including stale messages and gapped timestamps.
+pub proof fn lemma_owned_link_graph<T>(
+    root: RcuRootOwnedGhost<T, ()>,
+    history: AtomicHistory<*mut T>,
+    removed: Set<nat>,
+    source: AllocationId,
+    source_ptr: *mut T,
+)
+    requires
+        rcu_owned_root_history_inv(history, root),
+        removed.subset_of(root.infos().dom()),
+        source.domain != root.domain(),
+    ensures
+        owned_link_graph(root, removed, source, source_ptr).inv(),
+        owned_link_graph(root, removed, source, source_ptr).native_history(source, history),
+{
+    let graph = owned_link_graph(root, removed, source, source_ptr);
+    assert(graph.incoming.dom() =~= graph.objects.dom());
+    assert(graph.removed.subset_of(graph.objects.dom()));
+    assert forall|edge: LinkEdge| #[trigger] graph.events.contains_key(edge) implies {
+        &&& graph.objects.contains_key(edge.0)
+        &&& graph.events[edge] matches Some(child) ==> {
+            &&& graph.objects.contains_key(child)
+            &&& graph.incoming[child].contains(edge)
+        }
+    } by {
+        assert(root.root().publications().contains_key(edge.1));
+        if let Some(obj) = root.root().publications()[edge.1] {
+            assert(root.root().objects().contains_key(obj));
+            assert(root.infos().contains_key(obj));
+        }
+    };
+    assert forall|ts: nat| history.contains_timestamp(ts) implies {
+        &&& graph.events.contains_key((source, ts))
+        &&& match #[trigger] graph.events[(source, ts)] {
+            Some(child) => equal(history.value(ts), graph.objects[child]),
+            None => history.value(ts).addr() == 0,
+        }
+    } by {
+        assert(root.root().publications().contains_key(ts));
+        if let Some(obj) = root.root().publications()[ts] {
+            assert(equal(root.infos()[obj].ptr(), history.value(ts)));
+        }
+    };
+}
+
+/// The reader's actual native view bounds every historical edge it knows dead.
+pub proof fn lemma_observed_link_removals<T>(
+    tracked points_to: &AtomicPointsTo<*mut T>,
+    graph: LinkGraph<T>,
+    source: AllocationId,
+    domain: Loc,
+    removals: Map<nat, RcuRemovalObservation>,
+    view: ThreadView,
+) -> (res: (SeenRemoved, ThreadView))
+    requires
+        graph.inv(),
+        graph.native_history(source, points_to.hist()),
+        allocation_ids(domain, removals.dom()).subset_of(graph.removed),
+        forall|ts: nat|
+            points_to.hist().contains_timestamp(ts) ==> graph.events.contains_key((source, ts)),
+        forall|obj: nat| #[trigger]
+            removals.contains_key(obj) ==> {
+                &&& points_to.get_timestamp(removals[obj].message_view) == Some(
+                    removals[obj].timestamp,
+                )
+                &&& graph.events.contains_key((source, removals[obj].timestamp))
+                &&& forall|edge: LinkEdge| #[trigger]
+                    graph.incoming[AllocationId { domain, object: obj }].contains(edge) ==> {
+                        &&& edge.0 == source
+                        &&& edge.1 < removals[obj].timestamp
+                    }
+            },
+    ensures
+        res.0.sound(graph),
+        res.0.removed == allocation_ids(
+            domain,
+            removals.dom().filter(|obj: nat| removals[obj].observed_by(view)),
+        ),
+        res.0.links.dom().subset_of(Set::empty().insert(source)),
+        res.0.links.contains_key(source) ==> {
+            &&& view.contains(res.1)
+            &&& points_to.get_timestamp(res.1) == Some(res.0.seen_at(source))
+        },
+    decreases removals.len(),
+{
+    let visible = removals.dom().filter(|obj: nat| removals[obj].observed_by(view));
+    if visible.is_empty() {
+        assert(allocation_ids(domain, visible) =~= Set::<AllocationId>::empty());
+        (SeenRemoved { removed: Set::empty(), links: Map::empty() }, view)
+    } else {
+        let obj = visible.choose();
+        let rest = removals.remove(obj);
+        assert(allocation_ids(domain, rest.dom()).subset_of(graph.removed));
+        let (previous, previous_view) = lemma_observed_link_removals(
+            points_to,
+            graph,
+            source,
+            domain,
+            rest,
+            view,
+        );
+        let (links, observed_view) = if previous.links.contains_key(source) && previous.seen_at(
+            source,
+        ) >= removals[obj].timestamp {
+            (previous.links, previous_view)
+        } else {
+            (Map::empty().insert(source, removals[obj].timestamp), removals[obj].message_view)
+        };
+        let child = AllocationId { domain, object: obj };
+        let observed = SeenRemoved { removed: previous.removed.insert(child), links };
+        assert forall|id: AllocationId| #[trigger] observed.removed.contains(id) implies {
+            &&& graph.incoming.contains_key(id)
+            &&& forall|edge: LinkEdge| #[trigger]
+                graph.incoming[id].contains(edge) ==> observed.dead(edge)
+        } by {
+            assert forall|edge: LinkEdge| #[trigger]
+                graph.incoming[id].contains(edge) implies observed.dead(edge) by {
+                if id == child {
+                    assert(edge.0 == source && edge.1 < removals[obj].timestamp);
+                } else {
+                    assert(previous.dead(edge));
+                    assert(observed.seen_at(edge.0) >= previous.seen_at(edge.0));
+                }
+            };
+        };
+        assert(observed.removed =~= allocation_ids(domain, visible));
+        (observed, observed_view)
+    }
+}
+
+} // verus!
