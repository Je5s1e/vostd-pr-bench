+            final(owner).inv(),
+            final(self).wf(*final(owner)),
+            final(writer_owner).range@.start == old(writer_owner).range@.start + core::mem::size_of::<T>(),
+            final(writer_owner).range@.end == old(writer_owner).range@.end,
+            val_owner@.inv(),
