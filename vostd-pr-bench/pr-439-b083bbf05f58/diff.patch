+            old(self).inv(),
+            old(owner).inv(),
+            old(self).wf(*old(owner)),
+            old(owner).mem_view matches Some(VmIoMemView::ReadView(_)),
+            old(owner).mem_view matches Some(VmIoMemView::ReadView(mem_src)) ==> {
+                forall|i: usize|
+                    #![trigger mem_src.addr_transl(i)]
