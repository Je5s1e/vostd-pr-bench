+    /// Page Directory Pointer Tables, Page-Map Level-4 Table, and Page-Map Level-5
+    /// Table, respectively.
+    #[inline(always)]
+    #[verifier::when_used_as_spec(NR_LEVELS_spec)]
+    fn NR_LEVELS() -> (res: PagingLevel)
+        ensures
+            res == NR_LEVELS,
+            res == Self::NR_LEVELS_spec(),
+            res > 0,
+    ;
+
