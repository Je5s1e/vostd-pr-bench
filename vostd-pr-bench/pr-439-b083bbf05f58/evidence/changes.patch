+        tracked index: usize,
+        tracked value: V,
+    )
+        requires
+            old(perm).wf(),
+            old(perm).is_pptr(*self),
+            index < N,
+        ensures
+            perm.wf(),
+            perm.is_pptr(*self),
+            perm.is_init(index as int),
+            forall|i: int|
+                0 <= i < N && i != index ==> perm.opt_value()[i] == old(perm).opt_value()[i],
+            perm.opt_value()[index as int] == raw_ptr::MemContents::Init(value),
+    {
+        self.overwrite(Tracked(perm), index, value);
+    }
