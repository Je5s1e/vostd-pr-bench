+    ///
+    /// [valid]: crate::mm::io#safety
+    #[rustc_allow_incoherent_impl]
+    #[verus_spec(r =>
+        with
+            -> owner: Tracked<VmIoOwner<'a>>,
+        requires
+            len == 0 || KERNEL_BASE_VADDR() <= ptr.addr(),
+            len == 0 || ptr.addr() + len <= KERNEL_END_VADDR(),
+        ensures
