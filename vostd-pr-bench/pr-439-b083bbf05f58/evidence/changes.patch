+            owner_w.inv_with_writer(*writer),
+            owner_w.mem_view == Some(VmIoMemView::WriteView(old(self).mem_view@.unwrap().split_spec(
+                old(owner_w).range@.start,
+                (old(owner_w).range@.end - old(owner_w).range@.start) as usize,
