+verus! {
+
+#[inline(always)]
+#[verifier::when_used_as_spec(frame_to_meta_spec)]
+pub fn frame_to_meta(paddr: Paddr) -> (res: Vaddr)
+    requires
+        paddr % PAGE_SIZE() == 0,
+        paddr < MAX_PADDR(),
