+        p2: TreePath<N>,
+        p3: TreePath<N>,
+    )
+        requires
+            Self::is_prefix_of(p1, p2),
+            Self::is_prefix_of(p2, p3),
+        ensures
+            Self::is_prefix_of(p1, p3),
+    {
+        assert(p1.len() <= p3.len());
+        assert forall |i: int| 0 <= i < p1.len() implies p1.index(i) == p3.index(i) by {
+            assert(p1.index(i) == p2.index(i));
