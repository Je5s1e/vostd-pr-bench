+++ b/ostd/src/mm/frame/segment.rs
@@ -345,7 +345,7 @@ impl<M: AnyFrameMeta> Segment<M> {
     #[verus_spec(r =>
         with
             Tracked(regions): Tracked<&mut MetaRegionOwners>,
