+    /// The pervious value will be leaked if it was initialized.
+    #[inline(always)]
+    pub exec fn overwrite(
+        &self,
+        Tracked(perm): Tracked<&mut PointsTo<V, N>>,
+        index: usize,
+        value: V,
+    )
