+                va,
+            ) is Some by {
+                if owner_r.range@.start <= va && va < owner_r.range@.end {
+                    assert(borrowed_mv.mappings =~= mv.mappings.filter(
+                        |m: Mapping|
+                            m.va_range.start < (owner_r.range@.end) && m.va_range.end
