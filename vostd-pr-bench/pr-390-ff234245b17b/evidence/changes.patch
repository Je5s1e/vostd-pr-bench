+//     fn daddr(&self) -> Daddr {
+//         self.inner.read().start_daddr
+//     }
+// }
+
+impl Predicate<DmaStreamInner> for DmaStreaInnerOwner {
+    #[verifier::inline]
+    open spec fn predicate(&self, v: DmaStreamInner) -> bool {
+        // placeholder for now.
+        true
+    }
 }
 
