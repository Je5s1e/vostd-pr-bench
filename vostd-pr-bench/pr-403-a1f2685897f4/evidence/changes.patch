+    open spec fn from_spec(ptr: ReprPtr<R, T>) -> Self {
+        ptr.ptr
+    }
+}
+
 impl<R, T: Repr<R>> From<ReprPtr<R, T>> for PPtr<R> {
-    #[verifier::external_body]
     fn from(ptr: ReprPtr<R, T>) -> Self {
         ptr.ptr
     }

