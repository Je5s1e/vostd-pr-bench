+        range.start % PAGE_SIZE == 0,
+        range.end % PAGE_SIZE == 0,
+        range.start < range.end,
+        range.end <= MAX_PADDR,
+        // Every covered slot is a live SHARED Frame slot with headroom
+        // for one more reference (no saturation).
