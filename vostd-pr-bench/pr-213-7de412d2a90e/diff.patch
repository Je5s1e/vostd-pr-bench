+        p.and(always(p)) == always(p),
+{
+    assert forall|ex| #[trigger] always(p).satisfied_by(ex) implies p.and(always(p)).satisfied_by(
+        ex,
+    ) by {
+        always_to_current::<T>(ex, p);
