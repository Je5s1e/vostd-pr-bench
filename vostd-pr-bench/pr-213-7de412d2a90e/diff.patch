+    let a_to_not_p = |a: A| not(a_to_p(a));
+    assert forall|ex| #[trigger] tla_forall(a_to_not_p).satisfied_by(ex) implies not(
+        tla_exists(a_to_p),
+    ).satisfied_by(ex) by {
+        assert forall|a| !#[trigger] a_to_p(a).satisfied_by(ex) by {
+            assert(a_to_not_p(a).satisfied_by(ex));
+        };
+    };
