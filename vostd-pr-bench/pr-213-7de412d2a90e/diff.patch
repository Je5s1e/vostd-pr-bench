+proof fn a_to_temp_pred_equality<T, A>(p: spec_fn(A) -> TempPred<T>, q: spec_fn(A) -> TempPred<T>)
+    requires
+        forall|a: A| #[trigger] p(a).entails(q(a)) && q(a).entails(p(a)),
+    ensures
+        p == q,
+{
+    assert forall|a: A| #[trigger] p(a) == q(a) by {
+        temp_pred_equality::<T>(p(a), q(a));
+    };
