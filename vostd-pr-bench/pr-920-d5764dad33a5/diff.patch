+impl CpuModel {
+    pub open spec fn supports_avx(self) -> bool {
+        self.max_basic_leaf >= 1 && self.avx_bit
+    }
+
+    pub open spec fn supports_avx512f(self) -> bool {
+        self.max_basic_leaf >= 7 && self.avx512f_bit
+    }
