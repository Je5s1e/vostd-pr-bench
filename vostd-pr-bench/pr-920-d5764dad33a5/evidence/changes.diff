+/// Registers sampled by one feature query; no relation between separate reads is assumed.
+ghost struct CpuidFeatureSamples {
+    /// EAX from leaf 0, subleaf 0.
+    max_leaf: u32,
+    /// The queried feature register, absent when the maximum leaf excludes the query.
+    feature_bits: Option<u32>,
 }
 
+} // verus!
+// x86 0.52/raw-cpuid 10.7 delegates to __cpuid_count and preserves all registers.
+// In particular, __cpuid(0) is __cpuid_count(0, 0); reuse its existing external spec.
+/// Checks the sampled leaf 1 ECX AVX bit, without checking OS enablement.
+#[verus_spec(
+    with Tracked(samples): Tracked<&mut Ghost<CpuidFeatureSamples>>
+    ensures
+        (final(samples)@.feature_bits is Some) == (final(samples)@.max_leaf >= 1),
+    returns
+        (match final(samples)@.feature_bits {
+            Some(ecx) => ecx & (1u32 << 28) != 0,
+            None => false,
+        })
+)]
 fn has_avx() -> bool {
