+            (*tv)@ == old(self).view(),
+            final(self).task() == old(self).task(),
+            final(self).scheduler() == old(self).scheduler(),
+            final(self).view() == (*final(tv))@,
+    {
+        &mut self.thread_view
+    }
+}
