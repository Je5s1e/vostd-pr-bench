+                (Some(object), Some(info)) => {
+                    &&& res.0.addr() != 0
+                    &&& object.addr == res.0.addr()
+                    &&& info.wf()
+                    &&& info.domain() == object.domain
+                    &&& info.obj() == object.obj
+                    &&& info.addr() == object.addr
