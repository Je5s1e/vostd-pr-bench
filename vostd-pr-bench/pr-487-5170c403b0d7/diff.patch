+        perm.base() == base,
+        perm.domain() == base.domain(),
+        perm.ptr() == base.ptr(),
+        perm.obj() == base.obj(),
+        perm.seen_removed() == seen_removed,
+        perm.wf(),
+        perm.ready_to_retire(),
