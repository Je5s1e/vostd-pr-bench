+    tracked base: RcuBaseRetirePerm<T>,
+    seen_removed: RcuSeenRemoved<T>,
+) -> (tracked perm: RcuRetirePerm<T>)
+    requires
+        base.wf(),
+        seen_removed.removed.contains(base.obj()),
