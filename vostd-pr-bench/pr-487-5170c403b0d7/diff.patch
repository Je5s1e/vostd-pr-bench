+                                let tracked mut pool = entry.1;
+                                assert(pool.id() == id);
+                                assert(P::ptr_perm_match(entry.0@, pool@));
+                                assert(pool@.inv());
+                                assert(pool.wf());
+                                assert(pool.not_empty());
+                                pool.combine(token);
+                                assert(P::ptr_perm_match(entry.0@, pool@));
+                                assert(pool@.inv());
+                                assert(pool.wf());
+                                assert(pool.not_empty());
+                                g.retired.tracked_insert(id, (entry.0, pool));
+                            } else {
+                                assume(false);
+                            }
+                        }
+                    } else {
+                        if g.retired.contains_key(id) {
+                            let tracked entry = g.retired.tracked_remove(id);
+                            let tracked mut pool = entry.1;
+                            assert(pool.id() == id);
+                            assert(P::ptr_perm_match(entry.0@, pool@));
+                            assert(pool@.inv());
+                            assert(pool.wf());
+                            assert(pool.not_empty());
+                            pool.combine(token);
+                            assert(P::ptr_perm_match(entry.0@, pool@));
+                            assert(pool@.inv());
+                            assert(pool.wf());
+                            assert(pool.not_empty());
