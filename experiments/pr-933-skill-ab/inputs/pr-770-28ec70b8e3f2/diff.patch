+proof fn lemma_u64_nonzero_has_set_bit_aux(word: u64, n: u32)
+    requires
+        word != 0,
+        n <= 64,
+        word >> n == 0,
+    ensures
+        exists|b: u32| b < n && #[trigger] (word & (1u64 << b)) != 0,
+    decreases n,
+{
+    if n == 0 {
+        assert(word >> n == word) by (bit_vector)
