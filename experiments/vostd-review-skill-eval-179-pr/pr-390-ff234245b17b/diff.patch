+    pub open spec fn kernel_mem_view_covers(&self, view: &MemView) -> bool {
+        &&& self.inv()
+        &&& view.mappings.finite()
+        &&& view.mappings_are_disjoint()
+        &&& forall|vaddr: Vaddr|
