+                &&& view.memory.contains_key(view.addr_transl(vaddr).unwrap().0)
+                &&& view.memory[view.addr_transl(vaddr).unwrap().0].inv()
+                &&& view.memory[view.addr_transl(vaddr).unwrap().0].contents[view.addr_transl(
