+                        pte_token: Tracked(Some(pte_token)),
+                        stray_perm: Tracked(stray_perm),
+                        perms: Tracked(perms),
+                        in_protocol: Ghost(false),
+                    };
+                    assert(guard.wf(self));
+                    guard_opt = Some(guard);
+                    break;
+                },
+                _ => (),
+            };
+        }
+        let guard = guard_opt.unwrap();
+        guard
